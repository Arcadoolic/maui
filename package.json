{
    "name": "mame-awesome-ui",
    "description": "Awesome Frontend for Mame !",
    "author": "Snosky",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "serve": "vue-cli-service serve",
        "build": "vue-cli-service build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "probe:dev": "electron-vite dev",
        "probe:build": "electron-vite build",
        "probe:package": "electron-vite build && electron-builder --config electron-builder.yml",
        "test:watch": "vitest",
        "electron:build": "electron-vite build && electron-builder --config electron-builder.yml",
        "electron:serve": "electron-vite dev",
        "starting-pack": "ts-node -P scripts/tsconfig.json scripts/build-starting-pack.ts",
        "postinstall": "electron-builder install-app-deps",
        "postuninstall": "electron-builder install-app-deps",
        "rebuild": "electron-rebuild -f -w sqlite3"
    },
    "dependencies": {
        "@electron/remote": "^2.1.3",
        "@types/express": "^4.17.1",
        "adm-zip": "0.5.16",
        "csv-parse": "^4.3.3",
        "express": "^4.17.1",
        "ini": "^1.3.5",
        "mitt": "^3.0.1",
        "multer": "^2.3.0",
        "os": "^0.1.1",
        "pg-hstore": "^2.3.3",
        "reflect-metadata": "^0.1.13",
        "sequelize": "^5.18.4",
        "sequelize-typescript": "^1.0.0",
        "sqlite3": "^5.1.7",
        "velocity-animate": "^2.0.5",
        "vue": "^3.5.42",
        "vue-class-component": "^6.0.0",
        "vue-property-decorator": "^7.0.0",
        "vue-router": "^5.3.1",
        "vuex": "^3.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@swc/core": "^1.16.2",
        "@types/adm-zip": "^0.5.8",
        "@types/bluebird": "^3.5.27",
        "@types/ini": "^1.3.30",
        "@types/multer": "^2.2.0",
        "@types/umzug": "^2.2.2",
        "@types/validator": "^10.11.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/cli-plugin-typescript": "^3.4.0",
        "@vue/cli-service": "^3.4.0",
        "electron": "^44.3.0",
        "electron-builder": "^26.15.3",
        "electron-log": "^3.0.6",
        "electron-rebuild": "^3.2.9",
        "electron-vite": "5.0.0",
        "eslint": "^10.10.0",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "mame-hi-extractor": "^1.2.1",
        "sequelize-cli": "^5.5.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "umzug": "^2.2.0",
        "vite": "^7.3.6",
        "vitest": "^5.0.0",
        "vue-cli-plugin-electron-builder": "^1.0.0-rc.10",
        "vue-eslint-parser": "^10.4.1",
        "vue-template-compiler": "^2.5.21"
    },
    "overrides": {
        "electron-chromedriver": "44.3.0",
        "vuex": {
            "vue": "$vue"
        }
    },
    "main": "./out/main/index.js"
}
