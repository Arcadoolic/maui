# Transitional, for the Vue 2 -> Vue 3 migration window only.
#
# vue@3 is installed while vuex@3, vue-router@3, vue-class-component@6 and
# vue-property-decorator@7 are still present, and all four declare a
# `peerDependencies: { vue: "^2" }`. npm's strict peer resolution turns that
# into a hard ERESOLVE failure, so no `npm install` of any kind can run.
#
# The Vue 2 ecosystem packages are removed when the SFC are ported. Delete this
# file at that point and confirm a clean `npm install` still resolves.
legacy-peer-deps=true
