<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    tested with mame 0.206 and related hiscore.dat
  //-->

  <structure file=".hi">
    <loop count="5">
      <elt size="1" type="raw"  id="UNUSED"/>
      <elt size="3" type="raw"  id="SCORE"/>
      <elt size="1" type="raw"  id="UNUSED"/>
      <elt size="6" type="text" id="NAME" byte-skip="even" charset="spang"/>
      <elt size="1" type="raw"  id="UNUSED"/>
      <elt size="1" type="int"  id="STAGE1"/>
      <elt size="1" type="int"  id="STAGE2"/>
      <elt size="2" type="raw"  id="UNUSED"/>
    </loop>
    <loop count="5">
      <elt size="1" type="raw"  id="UNUSED"/>
      <elt size="3" type="raw"  id="PANIC SCORE"/>
      <elt size="1" type="raw"  id="UNUSED"/>
      <elt size="6" type="text" id="PANIC NAME" byte-skip="even" charset="spang"/>
      <elt size="2" type="raw"  id="UNUSED"/>
      <elt size="1" type="int"  id="PANIC STAGE"/>
      <elt size="2" type="raw"  id="UNUSED"/>
    </loop>
  </structure>

  <output>
    <table sort-order="desc" sort="TOP TOUR SCORE" id="TOUR MODE">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <column id="STAGE" format="tour_stage"/>
    </table>
    <table sort-order="desc" sort="TOP PANIC SCORE" id="PANIC MODE">
      <column id="PANIC RANK" src="index" format="+1"/>
      <column id="PANIC SCORE"/>
      <column id="PANIC NAME"/>
      <column id="PANIC STAGE"/>
    </table>
  </output>

      <format id="tour_stage">
    <concat>
      <txt>TOUR MODE (</txt>
      <column id="STAGE1"/>
      <txt>-</txt>
      <column id="STAGE2"/>
      <txt>)</txt>
    </concat>
  </format>
  <charset id="spang">
    <!--<char src="0x00" dst="."/>-->
    <char src="80" dst="A"/>
    <char src="82" dst="B"/>
    <char src="84" dst="C"/>
    <char src="86" dst="D"/>
    <char src="88" dst="E"/>
    <char src="8A" dst="F"/>
    <char src="8C" dst="G"/>
    <char src="8E" dst="H"/>
    <char src="A0" dst="I"/>
    <char src="A2" dst="J"/>
    <char src="A4" dst="K"/>
    <char src="A6" dst="L"/>
    <char src="A8" dst="M"/>
    <char src="AA" dst="N"/>
    <char src="AC" dst="O"/>
    <char src="AE" dst="P"/>
    <char src="C0" dst="Q"/>
    <char src="C2" dst="R"/>
    <char src="C4" dst="S"/>
    <char src="C6" dst="T"/>
    <char src="C8" dst="U"/>
    <char src="CA" dst="V"/>
    <char src="CC" dst="W"/>
    <char src="CE" dst="X"/>
    <char src="E0" dst="Y"/>
    <char src="E2" dst="Z"/>
  </charset>
</hi2txt>
