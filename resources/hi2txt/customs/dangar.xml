<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    tested with mame 0.148 and related hiscore.dat
      source: HiToText
  //-->

  <structure file=".hi">
    <loop count="10">
      <elt size="3" type="int"  id="SCORE"     base="16"/>
      <elt size="3" type="text" id="NAME"      charset="dangar"/>
      <elt size="7" type="raw"  id="UNUSED"/>
    </loop>
  </structure>

  <output>
    <table sort-order="desc" sort="SCORE">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" format="*100"/>
      <column id="NAME"/>
      <column id="UNUSED" format="hexadecimal_string" display="debug"/>
    </table>
  </output>

  <format id="*100"><multiply>100</multiply></format>
  <format id="-1"><substract>1</substract></format>
  <format id="+1"><add>1</add></format>

  <charset id="dangar">
    <char src="0x20" dst=" "/>
    <char src="0x2E" dst="."/>
  </charset>
</hi2txt>

