# Local, machine-specific paths. Copy this file to `.env` (git-ignored) and fill it in.
# Read by scripts/select-roms.py; a variable already set in your shell wins over this file.

# Root of your MAME ROM collection: the folder that holds the "MAME x.xxx ROMs (merged)" and
# "MAME x.xxx ROMs (bios-devices)" folders. Required unless you pass --source.
MAUI_ROMS_SOURCE=/path/to/your/Mame_0289

# Roms directory the selected zips are copied into. Optional, defaults to ~/.mame/roms.
#MAUI_ROMS_DEST=~/.mame/roms
